<?xml version="1.0"?>
<package format="3">
  <name>pybullet_arm_control</name>
  <version>0.1.0</version>
  <description>Trajectory action server and learning demos for the PyBullet arm lab.</description>
  <maintainer email="student@example.com">chengxunlinux</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>control_msgs</depend>
  <depend>pybullet_arm_interfaces</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
